{
  "extends": "@knockdog/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "css.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    "turbo/generators/config.ts"
  ],
  "exclude": ["node_modules", ".next", ".next/types"],
  "compilerOptions": {
    "skipLibCheck": true, // 라이브러리 체크 건너뛰기
    "strictNullChecks": true,
    "resolveJsonModule": true, // JSON import 허용
    "paths": {
      "@app/*": ["./src/app/*"],
      "@views/*": ["./src/views/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"],
      "@stores/*": ["./src/shared/store/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@providers/*": ["./src/app/providers/*"],
      "@constants/*": ["./src/shared/constants/*"],
      "@bridgeStore": ["./src/shared/store/useBridgeStore.ts"],
      "@type/*": ["./src/shared/types/*"],
      "react": ["./node_modules/@types/react"]
    }
  }
}
