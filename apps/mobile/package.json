{
  "name": "mobile",
  "main": "index.tsx",
  "version": "1.0.0",
  "scripts": {
    "build:bridges": "pnpm -r --filter \"@knockdog/bridge-native...\" build",
    "eas-build-post-install": "pnpm run build:bridges && if [ \"$EAS_BUILD_PLATFORM\" = \"android\" ]; then pnpm --filter mobile exec expo prebuild --platform android; else pnpm --filter mobile exec expo prebuild --platform ios; fi",
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
