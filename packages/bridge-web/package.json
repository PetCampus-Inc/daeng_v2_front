  "exports": {
    ".": {
      "types": "./dist/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@knockdog/bridge-core": "workspace:*"
  },
  "devDependencies": {
    "@knockdog/typescript-config": "workspace:*"
  }
}
