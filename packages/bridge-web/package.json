{
  "name": "@knockdog/bridge-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web bridge for communication with native apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p . --noEmit",
    "dev": "tsc -p . --noEmit",
    "typecheck": "tsc -p . --noEmit"
